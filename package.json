{
  "name": "rbmk-design",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "main-desktop.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder build --win portable"
  },
  "dependencies": {
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.rbmk.designer",
    "productName": "RBMK Designer",
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main-desktop.js"
    ]
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  }
}
